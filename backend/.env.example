# DevPilot AI - Backend Environment Configuration Template
# Copy this file to backend/.env and replace with your actual API key.

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
SECRET_KEY=devpilot_secure_secret_key_change_in_production

# CORS Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
DATABASE_URL=sqlite:///./devpilot.db

# Workspace storage for generated projects
WORKSPACES_ROOT=./workspaces
EXECUTION_TIMEOUT_SECONDS=30
